    "ccrStoreNode",
    "absorbHideNode",
    "crushNode",
    "absorbPromptNode",
    "filterNode",
    "hideCompressCallsNode",
    "relocateCompressCarriersNode",
    "viewLatchNode",
    "recommendNode",
    "nudgeNode",
    "emergencyTruncateNode"
  ],
  "marker": "/^\\p{So}(?:[ \\t])?\\[ACP\\][^\\n]*\\n?/gmu",
