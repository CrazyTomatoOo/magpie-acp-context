    "nudge.tier2GrowthMultiplier": 1.5,
    "promotionThreshold": 5,
    "truncate.threshold": 0.95,
    "truncate.terminalEscapeAfter": 3,
    "compress.minCompressRange": 5000,
    "compress.maxSummaryLength": 20000,
    "compress.minSummaryLength": 50,
    "preserveRecentMessages": 3,
    "preserveRecentTokens": 5000,
    "absorb.enabled": false,
    "absorb.minToolTokens": 4000,
    "absorb.contextThresholdPct": 0,
    "crush.enabled": false,
