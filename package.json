{
  "name": "magpie-acp-context",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "main": "./tools.mjs",
  "exports": {
    "./tools": "./tools.mjs",
    "./hooks": "./hooks.mjs"
  },
  "description": "ACP-style context compression for magpie, as async gateway hooks",
  "magpie": {
    "hooks": "./hooks.mjs",
    "options": {
      "enabled": true,
      "mode": "assist",
      "injectStyle": "append-user",
      "refFormat": "m%05d",
      "minRangeBytes": 5000,
      "maxSummaryChars": 20000,
      "keepRecentTurns": 3,
      "nudge": {
        "growthFloor": 50000
      },
      "store": {
        "dir": "~/.local/share/magpie-acp",
        "maxBytes": 536870912,
        "ttlDays": 30
      },
      "gatewayTimeoutMs": 3000,
      "failOpen": true,
      "updateCheck": true
    }
  },
  "scripts": {
    "test": "bun test test/",
    "cli": "node cli.mjs",
    "parity": "node scripts/parity-check.mjs"
  },
  "bin": {
    "magpie-acp": "./cli.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crazytomatooo/magpie-acp-context.git"
  },
  "keywords": [
    "magpie",
    "magpie-plugin",
    "context-compression",
    "acp"
  ]
}
